project:
  type: manuscript
  output-dir: public

manuscript:
  article: "manuscript.qmd"

format:
  html:
    code-fold: true
    code-wrap: true
    css: main.css
  docx:
    link-citations: true
    link-bibliography: true

execute:
  freeze: true

crossref:
  title-delim: "."
  custom:
    - kind: float
      key: suppfig
      reference-prefix: "Supplementary Figure"

callout-appearance: simple

highlight-style: github

bibliography: references.bib
